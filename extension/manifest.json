{
  "manifest_version": 3,
  "name": "Privileged Matter Activity Capture",
  "version": "0.1.0",
  "description": "Explicit, task-scoped metadata-only activity declarations.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Log task activity"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
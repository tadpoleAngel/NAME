{
  "manifest_version": 3,
  "name": "Privileged Matter Activity Capture",
  "version": "0.1.0",
  "description": "Explicit, task-scoped metadata-only activity declarations.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Log task activity"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3001/*",
      "https://tadpoleangel.github.io/*"
    ]
  },
  "host_permissions": [
    "http://localhost:3001/*",
    "https://name-ray5.onrender.com/*",
    "https://tadpoleangel.github.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
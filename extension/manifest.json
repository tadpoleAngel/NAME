{
  "manifest_version": 3,
  "name": "Privileged Matter Activity Capture",
  "version": "0.2.0",
  "description": "Automatic and manual task-scoped metadata-only activity declarations.",
  "action": {
    "default_popup": "review.html",
    "default_title": "Log task activity"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3001/*",
      "https://tadpoleangel.github.io/*"
    ]
  },
  "host_permissions": [
    "http://localhost:3001/*",
    "https://name-ray5.onrender.com/*",
    "https://tadpoleangel.github.io/*",
    "*://*.axon.com/*",
    "*://*.axon.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.axon.com/*", "*://*.axon.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}